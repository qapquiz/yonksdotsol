    {
      "id": "claim_8664e2006eaf43a69323083f7a8c82ab",
      "statement": "Pushing any `v*` tag (or workflow_dispatch) runs .github/workflows/android-build.yml: it provisions Bun, a Zulu JDK 17, and the Android SDK on the GitHub runner, installs dependencies with `bun install --frozen-lockfile`, authenticates EAS with the EXPO_TOKEN secret via expo/expo-github-action, then runs `bunx eas-cli build --platform android --local --profile preview --non-interactive` with EXPO_PUBLIC_RPC_URL and EXPO_PUBLIC_HELIUS_API_KEY injected as build env — the --local build is why the runner needs its own Android SDK and the Gradle-heap plugin — and uploads *.apk/*.aab as an artifact named android-<tag ref>.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/android-build.yml#L1-L52",
          "version": "repo-lines-v1:sha256:141ec9a72683355ff6a9767d8886cfdc5fe38cdabb77e38f68c99ebfa18130eb:"
        }
