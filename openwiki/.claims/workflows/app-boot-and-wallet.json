    {
      "id": "claim_97bb01ecde864f74b3d33c34c29decbb",
      "statement": "handleConnect signs in over Mobile Wallet Adapter via signIn({ domain: 'yonksdotsol.app', statement: 'Sign in to access your DLMM positions', version: '1' }), logs an Observe wallet.connect event with success and durationMs attributes (warn severity on failure), and on failure calls await disconnect().catch(() => {}) so a rejected or partially-authorized session is never left half-connected; isConnecting spans the whole attempt and disables the wallet button.",
