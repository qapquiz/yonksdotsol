  "claims": [
    {
      "id": "claim_5537df0da90d47f2b13246fb68cb2a78",
      "statement": "CacheManager state is two Maps on one instance — `cache` (key → {value, expiresAt}) and `pending` (key → in-flight Promise) — and every operation treats them as a unit: `set` writes an entry and deletes the pending promise, `delete`/`clear`/`invalidatePattern` remove from both, and `get`/`has` return misses for expired entries.",
      "evidence": [
        {
          "resource": "repo://src/__tests__/stores/CacheManager.test.ts#L39-L96",
          "version": "repo-lines-v1:sha256:b4e76daa23346628b95c49e3e7b20ff1d8fe7dc78152f74b25567041fe0b17d2:"
        },
        {
          "resource": "repo://src/utils/cache/CacheManager.ts#L6-L67",
          "version": "repo-lines-v1:sha256:a670167ea2f3631e1f1dca902c2d1ba7161e577a93fe0b8bd38562b3dca22653:"
        }
      ]
    },
    {
      "id": "claim_12e12b2ca89541d683f28aef3455b726",
      "statement": "getOrFetch deduplicates concurrent callers: a second getOrFetch for a key with an in-flight promise joins that promise instead of invoking fetchFn, so one fetch serves every caller.",
      "evidence": [
        {
          "resource": "repo://src/__tests__/stores/CacheManager.test.ts#L205-L223",
          "version": "repo-lines-v1:sha256:00edf149774f1ce917c4a41649d664869d9ba1d0539473b5401c6e865fa7f0f5:"
        },
        {
