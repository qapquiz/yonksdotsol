          "version": "repo-lines-v1:sha256:5cac30c19e60ff21f68407621af807ec73bdcb55eeb211995ea6f9bab685fe3f:"
        }
      ]
    },
    {
      "id": "claim_d6a028cd62d64e638ad17e709b57e6fe",
      "statement": "Only a fulfilled fetch reaches the cache: a rejected fetch propagates to all joined callers and leaves no cache entry (so the next request retries cleanly), while a fetched null IS cached for its TTL because getOrFetch checks entry existence rather than truthiness.",
      "evidence": [
        {
          "resource": "repo://src/__tests__/stores/CacheManager.test.ts#L163-L174",
          "version": "repo-lines-v1:sha256:d9e24d1f1d0e06476a545b5d2c68db1862ef6e3e2152e991848a1c22df1b25ef:"
