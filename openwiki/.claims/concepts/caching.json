    {
      "id": "claim_afaa5613d4c548eb998bb1a6ca166c9e",
      "statement": "An explicit `set` supersedes any in-flight fetch for the same key: it deletes the pending entry before writing, so a late-arriving response from the superseded fetch cannot overwrite the explicitly written value.",
      "evidence": [
